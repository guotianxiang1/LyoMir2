# --- added 2026-08-10: repo re-rooted at LyoMir2-master ---
# The previous repo was rooted at D:/loym2 and swallowed 80+ GB of scratch,
# which is why .git reached 2.4G with zero commits.

# vendored .NET SDK / NuGet cache (308M, 2457 files)
.dotnet-cli/

# build artifacts (108M)
artifacts/

# root-level icon dump (59M) -- NOT csproj-referenced. The leading slash is
# load-bearing: GameSvr/Resources, GameGate-CS/Resources and
# LoginGate/Resources ARE EmbeddedResource inputs and must stay tracked.
/Resources/

# Local analysis material (kept outside the source distribution)
/staging/

# Source distribution policy: notes, scripts, and generated reports stay local.
*.md
*.markdown
*.js
*.jsx
*.mjs
*.cjs
*.log
*.py
*.pyc
*.ps1
*.bat
*.cmd
*.csproj.user
/docs/
/tools/
/_audit/
/_work/
/.claude/

# runtime backups
_runtime_backup_*/

# stray scratch at the tree root
/_*.txt
/_*.xml
/build_out.txt
/LoginGate.ini
/MirGate.ini
/logs/

# publish output (163MB GameGate.exe + vendored runtime dlls);
# no csproj HintPath references any of it, so it is pure build output.
**/publish/

# run_audits.py output artifact (regenerated on every sweep, machine-specific
# paths and timings); the runner itself is committed, its results are not.
/AuditTools/_audit_report.json
