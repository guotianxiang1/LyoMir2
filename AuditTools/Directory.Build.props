<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Directory.Build.props')" />
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\AuditRepoRoot.cs"
             Link="AuditRepoRoot.cs"
             Condition="Exists('$(MSBuildThisFileDirectory)Shared\AuditRepoRoot.cs')" />
  </ItemGroup>
</Project>
