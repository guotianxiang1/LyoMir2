<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<IsPackable>false</IsPackable>
		<Company />
		<Product />
		<LangVersion>default</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration)=='Release' and $([MSBuild]::IsOSPlatform('Windows'))">
		<OutputPath>D:\lyom2Release\SystemModule\</OutputPath>
		<PublishDir>D:\lyom2Release\SystemModule\</PublishDir>
		<PublishUrl>D:\lyom2Release\SystemModule\</PublishUrl>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DefineConstants>TRACE;ISWOL</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DefineConstants>TRACE;ISWOL</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="System.Data.SQLite.Core" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="protobuf-net" Version="3.0.101" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>
</Project>
